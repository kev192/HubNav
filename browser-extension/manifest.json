{
  "manifest_version": 3,
  "name": "NavHub 浏览器书签同步",
  "version": "0.2.1",
  "description": "将浏览器新增书签单向同步到 NavHub 的“浏览器新增收藏”分类。",
  "permissions": ["bookmarks", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NavHub 书签同步",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
